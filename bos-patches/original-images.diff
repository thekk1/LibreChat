+/** BOS: Formate, die der Browser anzeigt, bleiben im Original; nur HEIC/HEIF wandelt LibreChat um. */
+const BOS_ORIGINAL_FORMATS = { png: 'image/png', jpeg: 'image/jpeg', gif: 'image/gif', webp: 'image/webp' };
+
+/** BOS: Abmessungen und Typ des unveraenderten Bildes, oder null, wenn es umgewandelt werden muss. */
+async function bosOriginalImageInfo(buffer) {
+  const meta = await sharp(buffer).metadata();
+  const type = BOS_ORIGINAL_FORMATS[meta.format];
+  if (!type || !meta.width || !meta.height) {
+    return null;
+  }
+  const swap = (meta.orientation ?? 1) >= 5;
+  return { type, width: swap ? meta.height : meta.width, height: swap ? meta.width : meta.height };
