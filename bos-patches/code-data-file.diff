+/** BOS-Patch code-data-file: laedt die Zeilen eines {{data:...}} als JSON-Datei in die Sandbox. */
+function bosCodeDataUploader(configurable, user) {
+	const upload = bosCodeUploader(configurable, user);
+	return async ({ name, content }) => {
+		const fs = require("fs");
+		const dir = await fs.promises.mkdtemp(require("path").join(require("os").tmpdir(), "bos-data-"));
+		const diskPath = require("path").join(dir, name);
+		try {
+			await fs.promises.writeFile(diskPath, content);
+			return await upload({ diskPath, name });
+		} finally {
+			await fs.promises.rm(dir, { recursive: true, force: true });
+		}
+	};
+}
