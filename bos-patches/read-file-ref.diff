+const BOS_READ_FILE_TEXT_MAX = 100 * 1024;
+const BOS_READ_FILE_REF = /^\s*\{\{file:([^{}\n]+?)\}\}\s*$/;
+async function bosReadFileRef(tc, scope, req) {
+	let args = tc.args ?? {};
+	if (typeof args === "string") try {
+		args = JSON.parse(args);
+	} catch {
+		args = {};
+	}
+	const match = String(args.path ?? "").match(BOS_READ_FILE_REF);
+	if (!match) return errorResult(tc, "read_file takes one {{file:...}} as the whole path, for example {{file:F-1a2b3c}}; nothing was read.");
+	const key = match[1].trim();
+	let doc;
+	let buffer;
+	try {
+		doc = await bosToolFiles.resolve(key, scope);
+		if (!doc) return errorResult(tc, `Unknown file reference ${key}; nothing was read. Use only IDs from [FILE] lines of this chat or names of files in this chat.`);
+		buffer = await require("fs").promises.readFile(doc.diskPath);
+	} catch (error) {
+		_librechat_data_schemas.logger.error("[bosToolFiles] read_file", error);
