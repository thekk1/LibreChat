+		if (buffer.length > MAX_SANDBOX_INLINE_IMAGE_BYTES) return {
+			toolCallId: tc.id,
+			status: "success",
+			content: `Image ${doc.name} is ${buffer.length} bytes, over the ${MAX_SANDBOX_INLINE_IMAGE_BYTES}-byte inline limit. Downscale it in code (execute_code or bash_tool with {{file:${key}}}) and read the smaller copy.`
+		};
+		return buildImageArtifactResult(tc.id, doc.name, mimeType, buffer.length, buffer.toString("base64"));
+	}
+	if (buffer.length <= BOS_READ_FILE_TEXT_MAX && !buffer.includes(0)) {
+		let content = null;
+		try {
+			content = new TextDecoder("utf-8", { fatal: true }).decode(buffer);
+		} catch {}
+		if (content != null) return filteredFileResult(tc, req, doc.name, content) ?? {
+			toolCallId: tc.id,
+			status: "success",
+			content: `File: ${doc.name} (${buffer.length} bytes)\n\n${content}`
+		};
+	}
